<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <Version>1.0.0</Version>
        <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="SPTarkov.Common" Version="4.1.2" />
        <PackageReference Include="SPTarkov.DI" Version="4.1.2" />
        <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" />
        <PackageReference Include="SPTarkov.Server.Web" Version="4.1.2" />
    </ItemGroup>
    <ItemGroup>
        <None Include="config.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <Target Name="CopyWwwroot" AfterTargets="Build">
        <ItemGroup>
            <WwwrootFiles Include="wwwroot\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(WwwrootFiles)" DestinationFiles="@(WwwrootFiles->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>
</Project>