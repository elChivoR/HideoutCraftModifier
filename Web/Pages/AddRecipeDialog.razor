@inject RecipeService RecipeService

<MudDialog>
    <DialogContent>
        <MudSelect @bind-Value="_areaType"
                   Label="Station"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Class="mb-3">
            @foreach (var area in _areas)
            {
                <MudSelectItem Value="@area">@PrettyStation(area)</MudSelectItem>
            }
        </MudSelect>

        <MudAutocomplete T="ItemSearchResult"
                         Label="Output item"
                         Placeholder="Search item..."
                         SearchFunc="@((q, _) => SearchItems(q))"
                         ToStringFunc="@(r => r?.Name ?? "")"
                         ValueChanged="@(r => { if (r is not null) _endProduct = r.TemplateId; })"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         MinCharacters="2"
                         DebounceInterval="300"
                         MaxItems="15"
                         Dense="true"
                         Class="mb-3" />

        <MudNumericField @bind-Value="_count"
                         Label="Output quantity"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Min="1" />

        @if (!string.IsNullOrWhiteSpace(_endProduct) && _endProduct.Length == 24)
        {
            <div class="d-flex align-center gap-1 mt-2">
                <img src="@($"/hcm/api/icon/{_endProduct}")" alt="" style="width:24px;height:24px;object-fit:contain;border-radius:2px;background:rgba(255,255,255,0.05);" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@RecipeService.ResolveItemName(_endProduct)</MudText>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="Submit" Disabled="@(string.IsNullOrWhiteSpace(_endProduct) || _endProduct.Length != 24)">Create craft</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _areaType = "Workbench";
    private string _endProduct = "";
    private int _count = 1;
    private List<string> _areas = [];

    protected override void OnInitialized()
    {
        _areas = RecipeService.GetCraftingAreaTypes();
        if (!_areas.Contains(_areaType) && _areas.Count > 0)
            _areaType = _areas[0];
    }

    private static string PrettyStation(string area) =>
        System.Text.RegularExpressions.Regex.Replace(area, "(?<=[a-z])(?=[A-Z])", " ");

    private Task<IEnumerable<ItemSearchResult>> SearchItems(string query)
    {
        var results = RecipeService.SearchItems(query);
        return Task.FromResult<IEnumerable<ItemSearchResult>>(results);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_endProduct) || _endProduct.Length != 24)
            return;

        var addition = new RecipeAddition
        {
            AreaType = _areaType,
            EndProduct = _endProduct,
            ProductionTime = 60,
            Count = _count,
            Requirements =
            [
                new RequirementConfig
                {
                    Type = "Area",
                    AreaType = (int)Enum.Parse<SPTarkov.Server.Core.Models.Enums.Hideout.HideoutAreas>(_areaType),
                    RequiredLevel = 1
                }
            ]
        };

        var recipeId = RecipeService.AddRecipe(addition);
        MudDialog.Close(DialogResult.Ok(recipeId));
    }
}
