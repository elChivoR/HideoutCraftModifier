@page "/hcm"
@layout BaseMudBlazorLayout
@inject RecipeService RecipeService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>HCM - Hideout Craft Modifier</PageTitle>

<HcmLayout>
    <div style="display:flex;gap:16px;align-items:flex-start;">
        <!-- Left Panel: Recipe List -->
        <MudPaper Elevation="0" Class="spt-panel" Style="width:500px;min-width:500px;height:calc(100vh - 140px);display:flex;flex-direction:column;overflow:hidden;position:sticky;top:16px;">
            <div style="flex-shrink:0;padding:12px;">
                <MudSelect @bind-Value="_areaFilter"
                           Label="Station"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Class="mb-2">
                    @foreach (var area in _availableAreas)
                    {
                        <MudSelectItem Value="@area">@area</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search by item, station or ID..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="mb-2" />

                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@FilteredRecipes.Count() crafts</MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddRecipeDialog">
                        Add craft
                    </MudButton>
                </div>
            </div>

            <div style="flex:1;overflow-y:auto;min-height:0;">
                @foreach (var recipe in FilteredRecipes)
                {
                    var isSelected = _selectedRecipe?.Id == recipe.Id;
                    <div class="hcm-recipe-item @(isSelected ? "hcm-recipe-selected" : "")"
                         @onclick="() => SelectRecipe(recipe)">
                        <div class="d-flex align-center gap-2">
                            <img src="@IconUrl(recipe.EndProductId)" alt="" class="hcm-list-icon" loading="lazy" />
                            <div class="flex-grow-1" style="min-width:0;">
                                <div class="d-flex align-center gap-1">
                                    <MudText Typo="Typo.body2" Class="text-truncate" Style="font-weight:500;">@recipe.EndProductName</MudText>
                                    @if (recipe.IsCustom)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Style="height:18px;font-size:10px;">Custom</MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@recipe.AreaName · x@(recipe.Count)</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size:10px;">@recipe.Id</MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="height:22px;font-size:11px;">@FormatTime(recipe.ProductionTime)</MudChip>
                        </div>
                    </div>
                }
            </div>
        </MudPaper>

        <!-- Right Panel: Detail/Edit -->
        <div style="flex:1;min-width:0;">
            @if (_selectedRecipe is not null)
            {
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <!-- Header -->
                    <div class="d-flex align-center justify-space-between" style="border-bottom:1px solid rgba(255,255,255,0.08);padding-bottom:14px;margin-bottom:16px;">
                        <div class="d-flex align-center gap-3">
                            <img src="@IconUrl(_selectedRecipe.EndProductId)" alt="" style="width:48px;height:48px;object-fit:contain;border-radius:6px;background:rgba(255,255,255,0.05);" />
                            <div>
                                <div class="d-flex align-center gap-2">
                                    <MudText Typo="Typo.h6">@_selectedRecipe.EndProductName</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Style="height:22px;font-size:11px;">@_selectedRecipe.AreaName</MudChip>
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size:10px;">@_selectedRecipe.Id</MudText>
                            </div>
                        </div>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.DeleteOutline"
                                   OnClick="() => RemoveRecipe(_selectedRecipe)">
                            Delete
                        </MudButton>
                    </div>

                    <!-- Production -->
                    <div class="hcm-section mb-3">
                        <MudText Typo="Typo.overline" Class="mud-text-secondary mb-2">PRODUCTION</MudText>
                        <div class="d-flex gap-3 align-center">
                            <MudNumericField @bind-Value="_editProductionTime"
                                             Label="Time (seconds)"
                                             Min="0.0"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Style="flex:1;" />
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Style="height:24px;">@FormatTime(_editProductionTime)</MudChip>
                            <MudNumericField @bind-Value="_editCount"
                                             Label="Count"
                                             Min="1"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Style="max-width:90px;" />
                            <MudNumericField @bind-Value="_editProductionLimitCount"
                                             Label="Limit (0 = unlimited)"
                                             Min="0"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Style="max-width:150px;" />
                        </div>
                    </div>

                    <!-- Flags -->
                    <div class="hcm-section mb-3">
                        <MudText Typo="Typo.overline" Class="mud-text-secondary mb-2">FLAGS</MudText>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 16px;">
                            <MudTooltip Text="Recipe is locked by default and must be unlocked (usually via quest completion)" Arrow="true" Placement="Placement.Top">
                                <MudSwitch T="bool" @bind-Value="_editLocked" Label="Locked" Color="Color.Primary" />
                            </MudTooltip>
                            <MudTooltip Text="Production repeats automatically after completion" Arrow="true" Placement="Placement.Top">
                                <MudSwitch T="bool" @bind-Value="_editContinuous" Label="Continuous" Color="Color.Primary" />
                            </MudTooltip>
                            <MudTooltip Text="Generator must have fuel running for the entire production duration" Arrow="true" Placement="Placement.Top">
                                <MudSwitch T="bool" @bind-Value="_editNeedFuel" Label="Needs fuel" Color="Color.Primary" />
                            </MudTooltip>
                            <MudTooltip Text="Recipe uses an encoded/encrypted input (e.g. Christmas tree ornaments)" Arrow="true" Placement="Placement.Top">
                                <MudSwitch T="bool" @bind-Value="_editIsEncoded" Label="Encoded" Color="Color.Primary" />
                            </MudTooltip>
                            <MudTooltip Text="Recipe produces a code or key as output" Arrow="true" Placement="Placement.Top">
                                <MudSwitch T="bool" @bind-Value="_editIsCodeProduction" Label="Code production" Color="Color.Primary" />
                            </MudTooltip>
                        </div>
                    </div>

                    <!-- Requirements -->
                    <div class="hcm-section mb-3">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">REQUIREMENTS (@_editRequirements.Count)</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="AddRequirement" />
                        </div>

                    @for (var i = 0; i < _editRequirements.Count; i++)
                    {
                        var index = i;
                        var req = _editRequirements[index];
                        <MudPaper Elevation="0" Class="spt-panel mb-2" Style="border-left:3px solid var(--mud-palette-primary);padding:10px 12px;">
                            <!-- Row 1: Type selector + delete -->
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudSelect @bind-Value="req.Type"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Style="max-width:130px;">
                                    <MudSelectItem Value="@("Item")">Item</MudSelectItem>
                                    <MudSelectItem Value="@("Area")">Area</MudSelectItem>
                                    <MudSelectItem Value="@("Tool")">Tool</MudSelectItem>
                                    <MudSelectItem Value="@("QuestComplete")">Quest</MudSelectItem>
                                    <MudSelectItem Value="@("Resource")">Resource</MudSelectItem>
                                </MudSelect>
                                <div style="flex:1;"></div>
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="() => _editRequirements.RemoveAt(index)" />
                            </div>

                            <!-- Row 2: Type-specific fields -->
                            @if (req.Type is "Item" or "Tool")
                            {
                                <div class="d-flex align-center gap-2">
                                    
                                    @if (!string.IsNullOrWhiteSpace(req.TemplateId) && req.TemplateId.Length == 24)
                                    {
                                        <div class="d-flex align-center gap-1">
                                            <img src="@IconUrl(req.TemplateId)" alt="" style="width:40px;height:40px;object-fit:contain;border-radius:2px;background:rgba(255,255,255,0.05);" />
                                            @* <MudText Typo="Typo.caption" Class="mud-text-secondary">@RecipeService.ResolveItemName(req.TemplateId)</MudText> *@
                                        </div>
                                    }
                                    
                                    <MudAutocomplete T="ItemSearchResult"
                                                     Placeholder="Search item..."
                                                     SearchFunc="@((q, _) => SearchItems(q))"
                                                     ToStringFunc="@(r => r?.Name ?? "")"
                                                     Value="req.SelectedItem"
                                                     ValueChanged="@(r =>
                                                                   {
                                                                       req.SelectedItem = r;
                                                                       req.TemplateId = r?.TemplateId;
                                                                   })"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Style="flex:1;"
                                                     MinCharacters="2"
                                                     DebounceInterval="300"
                                                     MaxItems="15"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceText="true"
                                                     Dense="true"/>
                                    @if (req.Type == "Item")
                                    {
                                        <MudNumericField @bind-Value="req.Count"
                                                         Label="x"
                                                         Min="1"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Style="max-width:75px;"/>
                                    }
                                    @if (req.Type == "Tool")
                                    {
                                        <MudCheckBox @bind-Value="req.IsFunctional" Label="Functional" Dense="true" Color="Color.Primary" Style="margin-bottom:0;"/>
                                    }
                                </div>
                                @*@if (!string.IsNullOrWhiteSpace(req.TemplateId) && req.TemplateId.Length == 24)
                                {
                                    <div class="d-flex align-center gap-1 mt-1">
                                        <img src="@IconUrl(req.TemplateId)" alt="" style="width:20px;height:20px;object-fit:contain;border-radius:2px;background:rgba(255,255,255,0.05);" />
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@RecipeService.ResolveItemName(req.TemplateId)</MudText>
                                    </div>
                                }*@
                            }
                            else if (req.Type == "Area")
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudSelect @bind-Value="req.AreaTypeStr"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Style="flex:1;">
                                        @foreach (var area in _allAreas)
                                        {
                                            <MudSelectItem Value="@area">@area</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudNumericField @bind-Value="req.RequiredLevel"
                                                     Label="Lvl"
                                                     Min="1"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Style="max-width:75px;" />
                                </div>
                            }
                            else if (req.Type == "QuestComplete")
                            {
                                <MudTextField @bind-Value="req.QuestId"
                                              Placeholder="Quest ID"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            }
                            else if (req.Type == "Resource")
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudAutocomplete T="ItemSearchResult"
                                                     Placeholder="Search item..."
                                                     SearchFunc="@((q, _) => SearchItems(q))"
                                                     ToStringFunc="@(r => r?.Name ?? "")"
                                                     Value="req.SelectedItem"
                                                     ValueChanged="@(r => { req.SelectedItem = r; req.TemplateId = r?.TemplateId; })"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Style="flex:1;"
                                                     MinCharacters="2"
                                                     DebounceInterval="300"
                                                     MaxItems="15"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceText="true"
                                                     Dense="true" />
                                    <MudNumericField @bind-Value="req.Resource"
                                                     Label="Amt"
                                                     Min="1"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Style="max-width:75px;" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(req.TemplateId) && req.TemplateId.Length == 24)
                                {
                                    <div class="d-flex align-center gap-1 mt-1">
                                        <img src="@IconUrl(req.TemplateId)" alt="" style="width:20px;height:20px;object-fit:contain;border-radius:2px;background:rgba(255,255,255,0.05);" />
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@RecipeService.ResolveItemName(req.TemplateId)</MudText>
                                    </div>
                                }
                            }

                        </MudPaper>
                    }

                    @if (_editRequirements.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-3" Align="Align.Center">No requirements</MudText>
                    }
                    </div>

                    <!-- Save -->
                    <div style="border-top:1px solid rgba(255,255,255,0.08);padding-top:12px;">
                        <div class="d-flex justify-end">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="SaveChanges">
                                Save Changes
                            </MudButton>
                        </div>
                    </div>
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="0" Class="spt-panel pa-6 d-flex flex-column align-center justify-center" Style="min-height:400px;">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Class="mud-text-secondary mb-2" />
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">Select a craft to edit</MudText>
                </MudPaper>
            }
        </div>
    </div>
</HcmLayout>

@code {
    private List<RecipeViewModel> _recipes = [];
    private string _searchText = "";
    private string? _areaFilter;
    private List<string> _availableAreas = [];
    private RecipeViewModel? _selectedRecipe;

    // Edit state
    private string _editArea = "";
    private double _editProductionTime;
    private int _editCount = 1;
    private int _editProductionLimitCount;
    private bool _editLocked;
    private bool _editContinuous;
    private bool _editNeedFuel;
    private bool _editIsEncoded;
    private bool _editIsCodeProduction;
    private List<RequirementEntry> _editRequirements = [];

    private static readonly List<string> _allAreas =
    [
        "Vents", "Security", "WaterCloset", "Stash", "Generator", "Heating",
        "WaterCollector", "MedStation", "Kitchen", "RestSpace", "Workbench",
        "IntelligenceCenter", "ShootingRange", "Library", "ScavCase",
        "Illumination", "AirFilteringUnit", "SolarPower", "BoozeGenerator",
        "BitcoinFarm", "Gym", "WeaponStand", "CircleOfCultists"
    ];

    private IEnumerable<RecipeViewModel> FilteredRecipes => _recipes.Where(r =>
    {
        if (!string.IsNullOrWhiteSpace(_areaFilter) && r.AreaName != _areaFilter)
            return false;

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var q = _searchText;
            if (!r.EndProductName.Contains(q, StringComparison.OrdinalIgnoreCase) &&
                !r.AreaName.Contains(q, StringComparison.OrdinalIgnoreCase) &&
                !r.Id.Contains(q, StringComparison.OrdinalIgnoreCase))
                return false;
        }

        return true;
    });

    protected override void OnInitialized()
    {
        LoadRecipes();
    }

    private void LoadRecipes()
    {
        _recipes = RecipeService.GetAllRecipes();
        _availableAreas = _recipes.Select(r => r.AreaName).Distinct().OrderBy(a => a).ToList();
    }

    private void SelectRecipe(RecipeViewModel recipe)
    {
        _selectedRecipe = recipe;
        _editArea = recipe.AreaName;
        _editProductionTime = recipe.ProductionTime;
        _editCount = recipe.Count;
        _editProductionLimitCount = recipe.ProductionLimitCount;
        _editLocked = recipe.Locked;
        _editContinuous = recipe.Continuous;
        _editNeedFuel = recipe.NeedFuelForAllProductionTime;
        _editIsEncoded = recipe.IsEncoded;
        _editIsCodeProduction = recipe.IsCodeProduction;
        _editRequirements = recipe.Requirements.Select(r => new RequirementEntry
        {
            Type = r.Type,
            TemplateId = r.TemplateId,
            SelectedItem = r.TemplateId is not null ? new ItemSearchResult { TemplateId = r.TemplateId, Name = r.ItemName ?? r.TemplateId } : null,
            AreaTypeStr = r.AreaName,
            RequiredLevel = r.RequiredLevel,
            Count = r.Count,
            IsFunctional = r.IsFunctional ?? false,
            QuestId = r.QuestId,
            Resource = r.Resource
        }).ToList();
    }

    private static string IconUrl(string? templateId) =>
        string.IsNullOrWhiteSpace(templateId) ? "" : $"/hcm/api/icon/{templateId}";

    private string FormatTime(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        if (ts.TotalHours >= 1)
            return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        if (ts.TotalMinutes >= 1)
            return $"{ts.Minutes}m {ts.Seconds}s";
        return $"{ts.Seconds}s";
    }

    private static Color GetTypeColor(string type) => type switch
    {
        "Item" => Color.Warning,
        "Tool" => Color.Info,
        "Area" => Color.Success,
        "QuestComplete" => Color.Secondary,
        "Resource" => Color.Primary,
        _ => Color.Default
    };

    private Task<IEnumerable<ItemSearchResult>> SearchItems(string query)
    {
        var results = RecipeService.SearchItems(query);
        return Task.FromResult<IEnumerable<ItemSearchResult>>(results);
    }

    private void AddRequirement()
    {
        _editRequirements.Add(new RequirementEntry { Type = "Item", Count = 1 });
    }

    private void SaveChanges()
    {
        if (_selectedRecipe is null) return;

        var requirements = _editRequirements.Select(r => new RequirementConfig
        {
            Type = r.Type,
            TemplateId = r.Type is "Item" or "Tool" or "Resource" ? r.TemplateId : null,
            AreaType = r.Type == "Area" ? (int?)Enum.Parse<SPTarkov.Server.Core.Models.Enums.Hideout.HideoutAreas>(r.AreaTypeStr ?? "Workbench") : null,
            RequiredLevel = r.Type == "Area" ? r.RequiredLevel : null,
            Count = r.Type == "Item" ? r.Count : null,
            IsFunctional = r.Type == "Tool" ? r.IsFunctional : null,
            QuestId = r.Type == "QuestComplete" ? r.QuestId : null,
            Resource = r.Type == "Resource" ? r.Resource : null
        }).ToList();

        var mod = new RecipeModification
        {
            ProductionTime = _editProductionTime,
            Count = _editCount,
            ProductionLimitCount = _editProductionLimitCount,
            Locked = _editLocked,
            Continuous = _editContinuous,
            NeedFuelForAllProductionTime = _editNeedFuel,
            IsEncoded = _editIsEncoded,
            IsCodeProduction = _editIsCodeProduction,
            Requirements = requirements
        };

        RecipeService.ModifyRecipe(_selectedRecipe.Id, mod);

        var selectedId = _selectedRecipe.Id;
        LoadRecipes();
        _selectedRecipe = _recipes.FirstOrDefault(r => r.Id == selectedId);
        if (_selectedRecipe is not null)
            SelectRecipe(_selectedRecipe);

        Snackbar.Add("Recipe updated!", Severity.Success);
    }

    private async Task OpenAddRecipeDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddRecipeDialog>("New craft", options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string recipeId })
        {
            LoadRecipes();
            var newRecipe = _recipes.FirstOrDefault(r => r.Id == recipeId);
            if (newRecipe is not null)
                SelectRecipe(newRecipe);
            Snackbar.Add("Recipe created! Edit requirements below.", Severity.Success);
        }
    }

    private async Task RemoveRecipe(RecipeViewModel recipe)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Remove the recipe for {recipe.EndProductName} in {recipe.AreaName}?" },
            { "ButtonText", "Remove" },
            { "Color", Color.Error }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Remove Recipe", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            RecipeService.RemoveRecipe(recipe.Id);
            _selectedRecipe = null;
            LoadRecipes();
            Snackbar.Add("Recipe removed!", Severity.Warning);
        }
    }

    private class RequirementEntry
    {
        public string Type { get; set; } = "Item";
        public string? TemplateId { get; set; }
        public ItemSearchResult? SelectedItem { get; set; }
        public string? AreaTypeStr { get; set; }
        public int? RequiredLevel { get; set; } = 1;
        public int? Count { get; set; } = 1;
        public bool IsFunctional { get; set; }
        public string? QuestId { get; set; }
        public int? Resource { get; set; }
    }
}
