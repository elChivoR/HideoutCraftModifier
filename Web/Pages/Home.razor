@page "/hcm"
@layout BaseMudBlazorLayout
@inject RecipeService RecipeService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>HCM - Hideout Craft Modifier</PageTitle>

<HcmLayout>
    <!-- Full-width station filter bar -->
    <!-- position:relative + z-index:10 creates a stacking context above the sticky list panel -->
    <MudPaper Elevation="0" Class="spt-panel hcm-station-bar pa-3 mb-4" Style="position:relative;z-index:10;">
        <div class="hcm-station-carousel">
            <!-- "All stations" card — no remove button -->
            <button type="button"
                    class="hcm-station-card @(_areaFilter is null ? "hcm-station-card--active" : "")"
                    @onclick="@(() => SelectStation(null))">
                <span class="hcm-station-card__icon">
                    <MudIcon Icon="@Icons.Material.Filled.GridView" />
                </span>
                <span class="hcm-station-card__label">All stations</span>
            </button>
            @foreach (var area in _availableAreas)
            {
                var a = area;
                var img = StationImage(a);
                <div class="hcm-station-card-wrapper">
                    <button type="button"
                            class="hcm-station-card @(_areaFilter == a ? "hcm-station-card--active" : "")"
                            @onclick="@(() => SelectStation(a))">
                        <span class="hcm-station-card__icon">
                            @if (img is not null)
                            {
                                <img class="hcm-station-card__img"
                                     src="@img"
                                     alt="@PrettyStation(a)"
                                     loading="lazy"
                                     onerror="this.classList.add('hcm-img-broken')" />
                            }
                            <MudIcon Icon="@StationIcon(a)" Class="hcm-station-card__fallback" />
                        </span>
                        <span class="hcm-station-card__label">@PrettyStation(a)</span>
                    </button>
                    <button type="button"
                            class="hcm-station-card__remove"
                            title="Remove @PrettyStation(a) from bar"
                            @onclick="@(() => RemoveStation(a))"
                            @onclick:stopPropagation="true">
                        ×
                    </button>
                </div>
            }
            <!-- "+" add station card -->
            <button type="button"
                    class="hcm-station-card hcm-add-station-card"
                    @onclick="ToggleAddStation">
                <span class="hcm-station-card__icon">
                    <span class="hcm-add-station-plus">+</span>
                </span>
                <span class="hcm-station-card__label">Add station</span>
            </button>
        </div>
        <!-- Dropdown outside the overflow:auto carousel but inside the z-index:10 MudPaper -->
        @if (_showAddStation)
        {
            <div class="hcm-add-station-backdrop" @onclick="CloseAddStation"></div>
            <div class="hcm-add-station-dropdown">
                @if (_hiddenStations.Count == 0)
                {
                    <div class="hcm-add-station-empty">All stations visible</div>
                }
                @foreach (var s in _hiddenStations)
                {
                    var station = s;
                    <button type="button"
                            class="hcm-add-station-item"
                            @onclick="@(() => AddStation(station))">
                        @PrettyStation(station)
                    </button>
                }
            </div>
        }
    </MudPaper>

    <div style="display:flex;gap:16px;align-items:flex-start;">
        <!-- Left Panel: Recipe List -->
        <MudPaper Elevation="0" Class="spt-panel" Style="width:500px;min-width:500px;height:calc(100vh - 140px);display:flex;flex-direction:column;overflow:hidden;position:sticky;top:16px;">
            <div style="flex-shrink:0;padding:12px;">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search by item, station or ID..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="mb-2" />

                @{
                    var tabBase = StationSearchFiltered.ToList();
                    var defaultCount = tabBase.Count(r => !r.IsCustom);
                    var customCount = tabBase.Count(r => r.IsCustom);
                    var removedCount = _removedRecipes.Count;
                }
                <div class="hcm-tab-toggle mb-2">
                    <button type="button"
                            class="@(_recipeTab == "default" ? "active" : "")"
                            @onclick='() => SwitchTab("default")'>
                        Default <span class="hcm-tab-count">@defaultCount</span>
                    </button>
                    <button type="button"
                            class="@(_recipeTab == "custom" ? "active" : "")"
                            @onclick='() => SwitchTab("custom")'>
                        New <span class="hcm-tab-count">@customCount</span>
                    </button>
                    <button type="button"
                            class="@(_recipeTab == "removed" ? "active" : "")"
                            @onclick='() => SwitchTab("removed")'>
                        Removed <span class="hcm-tab-count">@removedCount</span>
                    </button>
                </div>

                <div class="d-flex justify-space-between align-center gap-2 mb-2">
                    <MudSelect T="string" @bind-Value="_recipeSort"
                               Label="Sort"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Style="max-width:180px;">
                        <MudSelectItem Value="@("name")">Name (A–Z)</MudSelectItem>
                        <MudSelectItem Value="@("station")">Station</MudSelectItem>
                        <MudSelectItem Value="@("time")">Time (fastest first)</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddRecipeDialog">
                        Add craft
                    </MudButton>
                </div>
            </div>

            <div style="flex:1;overflow-y:auto;min-height:0;">
                @foreach (var recipe in FilteredRecipes)
                {
                    var isSelected = _selectedRecipe?.Id == recipe.Id;
                    var isRemovedTab = _recipeTab == "removed";
                    <div class="hcm-recipe-item @(isSelected ? "hcm-recipe-selected" : "")"
                         @onclick="() => TrySelectRecipe(recipe, isRemovedTab)">
                        <div class="d-flex align-center gap-2">
                            <img src="@IconUrl(recipe.EndProductId)" alt="" class="hcm-list-icon" loading="lazy" />
                            <div class="flex-grow-1" style="min-width:0;">
                                <div class="d-flex align-center gap-1">
                                    <MudText Typo="Typo.body2" Class="text-truncate" Style="font-weight:500;">@recipe.EndProductName</MudText>
                                    @if (recipe.IsCustom)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Style="height:18px;font-size:10px;">Custom</MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@recipe.AreaName · x@(recipe.Count)</MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="height:22px;font-size:11px;">@FormatTime(recipe.ProductionTime)</MudChip>
                        </div>
                    </div>
                }
            </div>
        </MudPaper>

        <!-- Right Panel: Detail/Edit -->
        <div style="flex:1;min-width:0;">
            @if (_selectedRecipe is not null && _selectedIsRemoved)
            {
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <div class="d-flex align-center justify-space-between" style="border-bottom:1px solid rgba(255,255,255,0.08);padding-bottom:14px;margin-bottom:16px;">
                        <div class="d-flex align-center gap-3">
                            <img src="@IconUrl(_selectedRecipe.EndProductId)" alt="" style="width:48px;height:48px;object-fit:contain;border-radius:6px;background:rgba(255,255,255,0.05);" />
                            <div>
                                <div class="d-flex align-center gap-2">
                                    <MudText Typo="Typo.h6">@_selectedRecipe.EndProductName</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Style="height:22px;font-size:11px;">@_selectedRecipe.AreaName</MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Style="height:22px;font-size:11px;">Removed</MudChip>
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size:10px;">@_selectedRecipe.Id</MudText>
                            </div>
                        </div>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.RestoreFromTrash"
                                   OnClick="() => RestoreRecipe(_selectedRecipe)">
                            Restore
                        </MudButton>
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        This recipe was removed. Click <strong>Restore</strong> to bring it back with its original SPT values.
                    </MudText>
                </MudPaper>
            }
            else if (_selectedRecipe is not null)
            {
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <!-- Header -->
                    <div class="d-flex align-center justify-space-between" style="border-bottom:1px solid rgba(255,255,255,0.08);padding-bottom:14px;margin-bottom:16px;">
                        <div class="d-flex align-center gap-3">
                            <img src="@IconUrl(_selectedRecipe.EndProductId)" alt="" style="width:48px;height:48px;object-fit:contain;border-radius:6px;background:rgba(255,255,255,0.05);" />
                            <div>
                                <div class="d-flex align-center gap-2">
                                    <MudText Typo="Typo.h6">@_selectedRecipe.EndProductName</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Style="height:22px;font-size:11px;">@_selectedRecipe.AreaName</MudChip>
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size:10px;">@_selectedRecipe.Id</MudText>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            @if (!_selectedRecipe.IsCustom)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.RestoreFromTrash"
                                           OnClick="() => RestoreRecipe(_selectedRecipe)">
                                    Restore original
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.DeleteOutline"
                                       OnClick="() => RemoveRecipe(_selectedRecipe)">
                                Delete
                            </MudButton>
                        </div>
                    </div>

                    <div class="hcm-detail-row mb-3">
                    <!-- Production -->
                    <div class="hcm-section hcm-detail-col">
                        <MudText Typo="Typo.overline" Class="mud-text-secondary mb-2">PRODUCTION</MudText>
                        <div class="d-flex gap-3 align-center mb-2">
                            <MudTooltip Text="Total crafting duration in seconds" Arrow="true" Placement="Placement.Top">
                                <MudNumericField @bind-Value="_editProductionTime"
                                                 Label="Time (seconds)"
                                                 Min="0.0"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Style="flex:1;" />
                            </MudTooltip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Style="height:24px;">@FormatTime(_editProductionTime)</MudChip>
                        </div>
                        <div class="d-flex gap-3 align-center">
                            <MudTooltip Text="Number of items produced per craft" Arrow="true" Placement="Placement.Top">
                                <MudNumericField @bind-Value="_editCount"
                                                 Label="Count"
                                                 Min="1"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Style="max-width:90px;" />
                            </MudTooltip>
                            <MudTooltip Text="Max times this recipe can be crafted. 0 = unlimited" Arrow="true" Placement="Placement.Top">
                                <MudNumericField @bind-Value="_editProductionLimitCount"
                                                 Label="Limit (0 = unlimited)"
                                                 Min="0"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Style="max-width:150px;" />
                            </MudTooltip>
                        </div>
                    </div>

                    <!-- Flags -->
                    <div class="hcm-section hcm-detail-col">
                        <MudText Typo="Typo.overline" Class="mud-text-secondary mb-2">FLAGS</MudText>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 16px;">
                            <MudTooltip Text="Recipe is locked by default and must be unlocked (usually via quest completion)" Arrow="true" Placement="Placement.Top">
                                <MudSwitch T="bool" @bind-Value="_editLocked" Label="Locked" Color="Color.Warning" />
                            </MudTooltip>
                            <MudTooltip Text="Production repeats automatically after completion" Arrow="true" Placement="Placement.Top">
                                <MudSwitch T="bool" @bind-Value="_editContinuous" Label="Continuous" Color="Color.Warning" />
                            </MudTooltip>
                            <MudTooltip Text="Generator must have fuel running for the entire production duration" Arrow="true" Placement="Placement.Top">
                                <MudSwitch T="bool" @bind-Value="_editNeedFuel" Label="Needs fuel" Color="Color.Warning" />
                            </MudTooltip>
                            <MudTooltip Text="Recipe uses an encoded/encrypted input (e.g. Christmas tree ornaments)" Arrow="true" Placement="Placement.Top">
                                <MudSwitch T="bool" @bind-Value="_editIsEncoded" Label="Encoded" Color="Color.Warning" />
                            </MudTooltip>
                            <MudTooltip Text="Recipe produces a code or key as output" Arrow="true" Placement="Placement.Top">
                                <MudSwitch T="bool" @bind-Value="_editIsCodeProduction" Label="Code production" Color="Color.Warning" />
                            </MudTooltip>
                        </div>
                    </div>
                    </div>

                    <!-- Requirements -->
                    <div class="hcm-section mb-3">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">REQUIREMENTS (@_editRequirements.Count)</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           Color="Color.Warning"
                                           OnClick="AddRequirement" />
                        </div>

                    @for (var i = 0; i < _editRequirements.Count; i++)
                    {
                        var index = i;
                        var req = _editRequirements[index];
                        <MudPaper Elevation="0" Class="spt-panel mb-2" Style="border-left:3px solid rgba(255,255,255,0.15);padding:10px 12px;">
                            <!-- Row 1: Type selector + delete -->
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudSelect @bind-Value="req.Type"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Style="max-width:130px;">
                                    <MudSelectItem Value="@("Item")">Item</MudSelectItem>
                                    <MudSelectItem Value="@("Area")">Area</MudSelectItem>
                                    <MudSelectItem Value="@("Tool")">Tool</MudSelectItem>
                                    <MudSelectItem Value="@("QuestComplete")">Quest</MudSelectItem>
                                    <MudSelectItem Value="@("Resource")">Resource</MudSelectItem>
                                </MudSelect>
                                <div style="flex:1;"></div>
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="() => _editRequirements.RemoveAt(index)" />
                            </div>

                            <!-- Row 2: Type-specific fields -->
                            @if (req.Type is "Item" or "Tool")
                            {
                                <div class="d-flex align-center gap-2">
                                    
                                    @if (!string.IsNullOrWhiteSpace(req.TemplateId) && req.TemplateId.Length == 24)
                                    {
                                        <div class="d-flex align-center gap-1">
                                            <img src="@IconUrl(req.TemplateId)" alt="" style="width:40px;height:40px;object-fit:contain;border-radius:2px;background:rgba(255,255,255,0.05);" />
                                            @* <MudText Typo="Typo.caption" Class="mud-text-secondary">@RecipeService.ResolveItemName(req.TemplateId)</MudText> *@
                                        </div>
                                    }
                                    
                                    <MudAutocomplete T="ItemSearchResult"
                                                     Placeholder="Search item..."
                                                     SearchFunc="@((q, _) => SearchItems(q))"
                                                     ToStringFunc="@(r => r?.Name ?? "")"
                                                     Value="req.SelectedItem"
                                                     ValueChanged="@(r =>
                                                                   {
                                                                       req.SelectedItem = r;
                                                                       req.TemplateId = r?.TemplateId;
                                                                   })"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Style="flex:1;"
                                                     MinCharacters="2"
                                                     DebounceInterval="300"
                                                     MaxItems="15"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceText="true"
                                                     Dense="true"/>
                                    @if (req.Type == "Item")
                                    {
                                        <MudNumericField @bind-Value="req.Count"
                                                         Label="x"
                                                         Min="1"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Style="max-width:75px;"/>
                                    }
                                    @if (req.Type == "Tool")
                                    {
                                        <MudCheckBox @bind-Value="req.IsFunctional" Label="Functional" Dense="true" Color="Color.Warning" Style="margin-bottom:0;"/>
                                    }
                                </div>
                                @*@if (!string.IsNullOrWhiteSpace(req.TemplateId) && req.TemplateId.Length == 24)
                                {
                                    <div class="d-flex align-center gap-1 mt-1">
                                        <img src="@IconUrl(req.TemplateId)" alt="" style="width:20px;height:20px;object-fit:contain;border-radius:2px;background:rgba(255,255,255,0.05);" />
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@RecipeService.ResolveItemName(req.TemplateId)</MudText>
                                    </div>
                                }*@
                            }
                            else if (req.Type == "Area")
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudSelect @bind-Value="req.AreaTypeStr"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Style="flex:1;">
                                        @foreach (var area in _allAreas)
                                        {
                                            <MudSelectItem Value="@area">@area</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudNumericField @bind-Value="req.RequiredLevel"
                                                     Label="Lvl"
                                                     Min="1"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Style="max-width:75px;" />
                                </div>
                            }
                            else if (req.Type == "QuestComplete")
                            {
                                <MudTextField @bind-Value="req.QuestId"
                                              Placeholder="Quest ID"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            }
                            else if (req.Type == "Resource")
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudAutocomplete T="ItemSearchResult"
                                                     Placeholder="Search item..."
                                                     SearchFunc="@((q, _) => SearchItems(q))"
                                                     ToStringFunc="@(r => r?.Name ?? "")"
                                                     Value="req.SelectedItem"
                                                     ValueChanged="@(r => { req.SelectedItem = r; req.TemplateId = r?.TemplateId; })"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Style="flex:1;"
                                                     MinCharacters="2"
                                                     DebounceInterval="300"
                                                     MaxItems="15"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceText="true"
                                                     Dense="true" />
                                    <MudNumericField @bind-Value="req.Resource"
                                                     Label="Amt"
                                                     Min="1"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Style="max-width:75px;" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(req.TemplateId) && req.TemplateId.Length == 24)
                                {
                                    <div class="d-flex align-center gap-1 mt-1">
                                        <img src="@IconUrl(req.TemplateId)" alt="" style="width:20px;height:20px;object-fit:contain;border-radius:2px;background:rgba(255,255,255,0.05);" />
                                    </div>
                                }
                            }

                        </MudPaper>
                    }

                    @if (_editRequirements.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-3" Align="Align.Center">No requirements</MudText>
                    }
                    </div>

                    <!-- Save -->
                    <div class="hcm-save-bar">
                        <div class="d-flex justify-end align-center gap-3">
                            @if (IsDirty)
                            {
                                <MudText Typo="Typo.caption" Style="color:#facc15;font-weight:600;">● Unsaved changes</MudText>
                            }
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="SaveChanges">
                                Save Changes
                            </MudButton>
                        </div>
                    </div>
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="0" Class="spt-panel pa-6 d-flex flex-column align-center justify-center" Style="min-height:400px;">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Class="mud-text-secondary mb-2" />
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">Select a craft to edit</MudText>
                </MudPaper>
            }
        </div>
    </div>
</HcmLayout>

@code {
    private List<RecipeViewModel> _recipes = [];
    private List<RecipeViewModel> _removedRecipes = [];
    private string _searchText = "";
    private string? _areaFilter;
    private string _recipeTab = "default"; // "default" = ships with SPT (incl. modified), "custom" = user-added, "removed" = deleted originals
    private string _recipeSort = "name"; // "name" | "station" | "time"
    private List<string> _availableAreas = [];
    private List<string> _hiddenStations = [];
    private bool _showAddStation;
    private RecipeViewModel? _selectedRecipe;
    private bool _selectedIsRemoved;
    private string _pristineSignature = ""; // form state as of the last SelectRecipe, for dirty tracking

    // Edit state
    private string _editArea = "";
    private double _editProductionTime;
    private int _editCount = 1;
    private int _editProductionLimitCount;
    private bool _editLocked;
    private bool _editContinuous;
    private bool _editNeedFuel;
    private bool _editIsEncoded;
    private bool _editIsCodeProduction;
    private List<RequirementEntry> _editRequirements = [];

    private static readonly List<string> _allAreas =
        Enum.GetNames<HideoutAreas>()
            .Where(n => n != "NotSet")
            .OrderBy(n => n)
            .ToList();

    // Recipes matching the station + search filters, before the Default/New tab split.
    // Drives the tab counters so they reflect what's currently in view.
    private IEnumerable<RecipeViewModel> StationSearchFiltered => _recipes.Where(r =>
    {
        if (!string.IsNullOrWhiteSpace(_areaFilter) && r.AreaName != _areaFilter)
            return false;

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var q = _searchText;
            if (!r.EndProductName.Contains(q, StringComparison.OrdinalIgnoreCase) &&
                !r.AreaName.Contains(q, StringComparison.OrdinalIgnoreCase) &&
                !r.Id.Contains(q, StringComparison.OrdinalIgnoreCase))
                return false;
        }

        return true;
    });

    private IEnumerable<RecipeViewModel> FilteredRecipes
    {
        get
        {
            IEnumerable<RecipeViewModel> list = _recipeTab == "removed"
                ? _removedRecipes.Where(r =>
                {
                    if (!string.IsNullOrWhiteSpace(_areaFilter) && r.AreaName != _areaFilter) return false;
                    if (!string.IsNullOrWhiteSpace(_searchText))
                    {
                        var q = _searchText;
                        if (!r.EndProductName.Contains(q, StringComparison.OrdinalIgnoreCase) &&
                            !r.AreaName.Contains(q, StringComparison.OrdinalIgnoreCase) &&
                            !r.Id.Contains(q, StringComparison.OrdinalIgnoreCase))
                            return false;
                    }
                    return true;
                })
                : StationSearchFiltered.Where(r => _recipeTab == "custom" ? r.IsCustom : !r.IsCustom);

            return _recipeSort switch
            {
                "station" => list.OrderBy(r => r.AreaName).ThenBy(r => r.EndProductName, StringComparer.OrdinalIgnoreCase),
                "time" => list.OrderBy(r => r.ProductionTime).ThenBy(r => r.EndProductName, StringComparer.OrdinalIgnoreCase),
                _ => list.OrderBy(r => r.EndProductName, StringComparer.OrdinalIgnoreCase)
            };
        }
    }

    protected override void OnInitialized()
    {
        LoadRecipes();
    }

    private void LoadRecipes()
    {
        _recipes = RecipeService.GetAllRecipes();
        _removedRecipes = RecipeService.GetRemovedRecipes();
        RefreshAvailableAreas();
    }

    private void RefreshAvailableAreas()
    {
        _availableAreas = RecipeService.GetVisibleStations();
        _hiddenStations = RecipeService.AllStations
            .Except(_availableAreas)
            .OrderBy(RecipeService.PrettyStation, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (_areaFilter is not null && !_availableAreas.Contains(_areaFilter))
            _areaFilter = null;
    }

    private void ToggleAddStation() => _showAddStation = !_showAddStation;
    private void CloseAddStation() => _showAddStation = false;

    private void AddStation(string area)
    {
        _showAddStation = false;
        var visible = RecipeService.GetVisibleStations();
        if (!visible.Contains(area))
            visible.Add(area);
        RecipeService.SaveVisibleStations(visible);
        RefreshAvailableAreas();
    }

    private void RemoveStation(string area)
    {
        if (_areaFilter == area) _areaFilter = null;
        var visible = RecipeService.GetVisibleStations();
        visible.Remove(area);
        RecipeService.SaveVisibleStations(visible);
        RefreshAvailableAreas();
    }


    private void SelectRecipe(RecipeViewModel recipe, bool isRemoved = false)
    {
        _selectedIsRemoved = isRemoved;
        _selectedRecipe = recipe;
        _editArea = recipe.AreaName;
        _editProductionTime = recipe.ProductionTime;
        _editCount = recipe.Count;
        _editProductionLimitCount = recipe.ProductionLimitCount;
        _editLocked = recipe.Locked;
        _editContinuous = recipe.Continuous;
        _editNeedFuel = recipe.NeedFuelForAllProductionTime;
        _editIsEncoded = recipe.IsEncoded;
        _editIsCodeProduction = recipe.IsCodeProduction;
        _editRequirements = recipe.Requirements.Select(r => new RequirementEntry
        {
            Type = r.Type,
            TemplateId = r.TemplateId,
            SelectedItem = r.TemplateId is not null ? new ItemSearchResult { TemplateId = r.TemplateId, Name = r.ItemName ?? r.TemplateId } : null,
            AreaTypeStr = r.AreaName,
            RequiredLevel = r.RequiredLevel,
            Count = r.Count,
            IsFunctional = r.IsFunctional ?? false,
            QuestId = r.QuestId,
            Resource = r.Resource
        }).ToList();

        _pristineSignature = CurrentFormSignature();
    }

    // Stable serialization of every editable field, used to detect unsaved changes.
    private string CurrentFormSignature() => System.Text.Json.JsonSerializer.Serialize(new
    {
        _editProductionTime,
        _editCount,
        _editProductionLimitCount,
        _editLocked,
        _editContinuous,
        _editNeedFuel,
        _editIsEncoded,
        _editIsCodeProduction,
        reqs = _editRequirements.Select(r => new
        {
            r.Type, r.TemplateId, r.AreaTypeStr, r.RequiredLevel, r.Count, r.IsFunctional, r.QuestId, r.Resource
        })
    });

    private bool IsDirty => _selectedRecipe is not null && CurrentFormSignature() != _pristineSignature;

    private async Task<bool> ConfirmDiscardIfDirty()
    {
        if (!IsDirty) return true;

        var parameters = new DialogParameters
        {
            { "ContentText", "You have unsaved changes to this recipe. Discard them?" },
            { "ButtonText", "Discard" },
            { "Color", Color.Error }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Unsaved changes", parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false };
    }

    private async Task TrySelectRecipe(RecipeViewModel recipe, bool isRemoved = false)
    {
        if (recipe.Id == _selectedRecipe?.Id) return;
        if (!await ConfirmDiscardIfDirty()) return;
        SelectRecipe(recipe, isRemoved);
    }

    private async Task SwitchTab(string tab)
    {
        if (!await ConfirmDiscardIfDirty()) return;
        _recipeTab = tab;
        _selectedRecipe = null;
        _selectedIsRemoved = false;
    }

